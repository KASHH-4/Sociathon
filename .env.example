# Environment configuration for TransitHear
# Copy to .env and fill in your values. Never commit .env.

# ── Supabase ──────────────────────────────────────────────────
# Create project at https://supabase.com
# Run supabase/schema.sql in the SQL editor, then seed_supabase.py
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini ─────────────────────────────────────────────
# Get key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Reliability thresholds ────────────────────────────────────
THRESH_ALERT=0.75
THRESH_VERIFY=0.50
DEDUPE_SECONDS=60

# ── Input safety ─────────────────────────────────────────────
MAX_TRANSCRIPT_CHARS=1000
RATE_LIMIT_PER_MIN=30

# ── Server ────────────────────────────────────────────────────
PORT=5000

# ── Simulation ────────────────────────────────────────────────
SIMULATED_OFFICIAL_FEED=true
